# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Leave empty to use built-in local persistent storage or connect to MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/skilltrack

# JWT Secret
JWT_SECRET=skilltrack_super_secret_jwt_key_2026_placement_ai

# AI Integration Configuration (Google Gemini API / OpenAI API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=

# Code Execution Service (Judge0 API via RapidAPI or Self-Hosted)
# Leave empty to use SkillTrack built-in sandboxed runner
RAPIDAPI_KEY=
RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
